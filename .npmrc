# O Baileys rc13 declara link-preview-js ^3 como peer opcional, embora use a API que segue
# compatível na versão 4. A v3 tem SSRF conhecido; mantemos a v4 corrigida até o peer upstream
# ser atualizado. Este arquivo faz npm ci reproduzir exatamente essa decisão no CI e na VPS.
legacy-peer-deps=true
engine-strict=true
